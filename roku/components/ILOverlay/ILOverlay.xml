<?xml version="1.0" encoding="utf-8"?>
<component name="ILOverlay" extends="Group">
    <interface>
        <function name="attach" />
        <function name="detach" />
        <function name="setTimeline" />
        <function name="setLinearAd" />
        <function name="setManifest" />
        <function name="setClockAnchor" />
        <function name="getProgramTimeMs" />
        <function name="handleCommerceKey" />
        <field id="commerceEnabled" type="boolean" onChange="onCommerceChanged" />
        <field id="commerceAutoFocus" type="boolean" value="true" />
        <field id="sceneLink" type="assocarray" alwaysNotify="true" />
        <field id="productView" type="assocarray" alwaysNotify="true" />
        <field id="linearBreak" type="boolean" onChange="onLinearBreakChanged" />
        <field id="seeking" type="boolean" onChange="refresh" />
        <field id="impression" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/ILOverlay/ILTimeline.brs" />
    <script type="text/brightscript" uri="pkg:/components/ILOverlay/ILManifest.brs" />
    <script type="text/brightscript" uri="pkg:/components/ILOverlay/ILOverlay.brs" />
    <script type="text/brightscript" uri="pkg:/components/ILOverlay/ILShopOptions.brs" />
    <script type="text/brightscript" uri="pkg:/components/ILOverlay/ILShopView.brs" />
    <script type="text/brightscript" uri="pkg:/components/ILOverlay/ILCommerce.brs" />
    <script type="text/brightscript" uri="pkg:/components/ILOverlay/ILScene.brs" />
    <children>
        <Timer id="ilClock" duration="0.1" repeat="true" />
        <Group id="ilArt" visible="false">
            <Group id="ilPrimary" />
            <Group id="ilSecondary" />
        </Group>
        <Group id="ilCommerce" visible="false">
            <Rectangle id="ilCommerceBackground" color="0x202020FF" />
            <Label id="ilCommerceTrigger" width="266" height="54" vertAlign="center" horizAlign="center">
                <Font role="font" uri="font:SystemFontFile" size="22" />
            </Label>
            <Group id="ilCommerceDetail" visible="false">
                <Poster id="ilCommerceGalleryLeft" loadDisplayMode="scaleToFit" />
                <Poster id="ilCommerceGalleryRight" loadDisplayMode="scaleToFit" />
                <Poster id="ilCommercePhoto" loadDisplayMode="scaleToFit" />
                <Poster id="ilCommerceLogo" loadDisplayMode="scaleToFit" />
                <Poster id="ilCommerceQr" loadDisplayMode="scaleToFit" />
                <Label id="ilCommerceHeading" vertAlign="center" horizAlign="left" wrap="true" maxLines="1" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:BoldSystemFontFile" size="23" />
                </Label>
                <Label id="ilCommerceName" vertAlign="center" horizAlign="left" wrap="true" maxLines="2" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:BoldSystemFontFile" size="28" />
                </Label>
                <Label id="ilCommercePrevious" vertAlign="center" horizAlign="left" wrap="true" maxLines="1" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:SystemFontFile" size="18" />
                </Label>
                <Label id="ilCommercePrice" vertAlign="center" horizAlign="left" wrap="true" maxLines="1" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:BoldSystemFontFile" size="29" />
                </Label>
                <Label id="ilCommerceDescription" vertAlign="center" horizAlign="left" wrap="true" maxLines="3" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:SystemFontFile" size="19" />
                </Label>
                <Label id="ilCommerceSummary" vertAlign="center" horizAlign="left" wrap="true" maxLines="3" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:SystemFontFile" size="21" />
                </Label>
                <Label id="ilCommerceTotal" vertAlign="center" horizAlign="left" wrap="true" maxLines="2" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:BoldSystemFontFile" size="26" />
                </Label>
                <Label id="ilCommerceAmount" vertAlign="center" horizAlign="right">
                    <Font role="font" uri="font:BoldSystemFontFile" size="26" />
                </Label>
                <Label id="ilCommerceGalleryPrev" vertAlign="center" horizAlign="center">
                    <Font role="font" uri="font:BoldSystemFontFile" size="42" />
                </Label>
                <Label id="ilCommerceGalleryNext" vertAlign="center" horizAlign="center">
                    <Font role="font" uri="font:BoldSystemFontFile" size="42" />
                </Label>
                <Label id="ilCommerceStatus" vertAlign="center" horizAlign="center" wrap="true" maxLines="3" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:SystemFontFile" size="20" />
                </Label>
                <Rectangle id="ilCommerceGalleryBackground" color="0x202020EC" />
                <Label id="ilCommerceGallery" vertAlign="center" horizAlign="center" wrap="true" maxLines="1" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:BoldSystemFontFile" size="20" />
                </Label>
                <Label id="ilCommerceArrows" vertAlign="center" horizAlign="center" wrap="true" maxLines="1" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:BoldSystemFontFile" size="25" />
                </Label>
                <Label id="ilCommerceClose" vertAlign="center" horizAlign="center" wrap="true" maxLines="1" ellipsizeOnBoundary="true">
                    <Font role="font" uri="font:SystemFontFile" size="19" />
                </Label>
                <Group id="ilCommerceChips" />
                <Rectangle id="ilCommerceBuyBackground" color="0xF0F0F0FF" />
                <Label id="ilCommerceBuy" vertAlign="center" horizAlign="center" color="0x202020FF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="23" />
                </Label>
            </Group>
        </Group>
    </children>
</component>
